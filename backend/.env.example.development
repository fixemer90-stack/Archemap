# Astrotype — Development Environment
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://astrotype:astrotype@localhost:5432/astrotype
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ── Auth / OAuth ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Yandex OAuth (get from https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/yandex/callback
FRONTEND_URL=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@astrotype.ru
# SMTP_FROM_NAME=Astrotype

# ── Object Storage (MinIO) ──────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=astrotype
S3_REGION=us-east-1

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Sentry (optional) ───────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
