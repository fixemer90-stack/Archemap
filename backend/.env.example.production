# Astrotype — Production Environment
# ALL secrets MUST be set. No defaults allowed.
# Use a secrets manager (Yandex Lockbox, HashiCorp Vault) in production.

# ── Application ──────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=
ALLOWED_ORIGINS=["https://astrotype.ru", "https://www.astrotype.ru"]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_CACHE_TTL=300

# ── Auth / OAuth ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://astrotype.ru/api/v1/auth/oauth/yandex/callback
FRONTEND_URL=https://astrotype.ru

# ── Email ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=noreply@astrotype.ru
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@astrotype.ru
SMTP_FROM_NAME=Astrotype

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GEOCODE_PER_MINUTE=30
