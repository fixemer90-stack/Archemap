# Astrotype — Staging Environment
# All secrets MUST be set (no defaults)

# ── Application ──────────────────────────────────────────────────────
APP_ENV=staging
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=
ALLOWED_ORIGINS=["https://staging.astrotype.ru"]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_CACHE_TTL=300

# ── Auth / OAuth ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://staging.astrotype.ru/api/v1/auth/oauth/yandex/callback
FRONTEND_URL=https://staging.astrotype.ru

# ── Email ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@astrotype.ru
SMTP_FROM_NAME=Astrotype

# ── Object Storage ──────────────────────────────────────────────────
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=astrotype-staging
S3_REGION=ru-central1

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
