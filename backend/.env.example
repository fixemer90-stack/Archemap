# LLM narrative layer example settings
# Copy the needed values into backend/.env for local development.
# For Docker Compose from repo root, prefer /home/balthier/archemap/.env.

LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-self-v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Career report local rollout and observability.
CAREER_REPORT_ENABLED=false
CAREER_STUCK_AFTER_MINUTES=20
CAREER_VALIDATOR_ALERT_THRESHOLD=5
CAREER_MONITOR_WINDOW_MINUTES=15
CAREER_LLM_INPUT_COST_PER_MILLION=0
CAREER_LLM_OUTPUT_COST_PER_MILLION=0
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_SERVICE_NAME=archemap-local
