# Astrotype staging environment for docker-compose.staging.yml.
# Copy to .env.staging on the VPS. Never commit populated values.

COMPOSE_PROJECT_NAME=astrotype-staging

POSTGRES_USER=astrotype_staging
POSTGRES_PASSWORD=
POSTGRES_DB=astrotype_staging

APP_ENV=staging
APP_DEBUG=false
SECRET_KEY=
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1

FRONTEND_URL=https://staging.astrotype.ru
ALLOWED_ORIGINS=["https://staging.astrotype.ru"]

# Staging Basic Auth is stored in the untracked
# deploy/staging-basic-auth.caddy file; see the runbook.

# Use YooKassa test-shop credentials only.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Keep provider calls disabled unless a staging scenario explicitly needs them.
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-self-v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

EMAIL_PROVIDER=console
AUTO_VERIFY_EMAIL=true
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@astrotype.ru
SMTP_FROM_NAME=Astrotype Staging

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GEOCODE_PER_MINUTE=90
