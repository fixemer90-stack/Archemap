# Astrotype production environment for docker-compose.prod.yml.
# Copy this to .env.production on the VPS and fill every secret.

POSTGRES_USER=astrotype
POSTGRES_PASSWORD=change-this-random-password
POSTGRES_DB=astrotype

APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change-this-random-secret
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1

FRONTEND_URL=https://astrotype.ru
ALLOWED_ORIGINS=["https://astrotype.ru","https://www.astrotype.ru"]
YANDEX_REDIRECT_URI=https://astrotype.ru/api/v1/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=noreply@astrotype.ru
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@astrotype.ru
SMTP_FROM_NAME=Astrotype

LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GEOCODE_PER_MINUTE=30
